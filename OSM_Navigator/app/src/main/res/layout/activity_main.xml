<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".presentation.main.MainActivity">

    <!-- Карта OSM -->
    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Панель поиска сверху -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/searchCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="28dp"
        app:cardElevation="4dp">
        
        <LinearLayout
            android:id="@+id/btnSearch"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:background="?attr/selectableItemBackground">
            
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_search"
                android:contentDescription="Поиск" />
            
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:text="Куда едем?"
                android:textSize="16sp"
                android:textColor="@android:color/darker_gray" />
            
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Карточка телематики Т-Бокс (справа сверху) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardTelemetry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="80dp"
        android:layout_marginEnd="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@color/card_background">
        
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:minWidth="140dp">
            
            <!-- Заголовок -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Телематика"
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurfaceVariant" />
                
                <ImageView
                    android:id="@+id/ivTelemetryStatus"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@android:drawable/presence_invisible" />
            </LinearLayout>
            
            <!-- SOC батареи -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">
                
                <TextView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:text="🔋"
                    android:textSize="14sp" />
                
                <TextView
                    android:id="@+id/tvBatterySoc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="--%"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/charging_green" />
            </LinearLayout>
            
            <!-- Скорость -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">
                
                <TextView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:text="🚗"
                    android:textSize="14sp" />
                
                <TextView
                    android:id="@+id/tvSpeed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="-- км/ч"
                    android:textSize="14sp" />
            </LinearLayout>
            
            <!-- Статус дверей -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">
                
                <TextView
                    android:id="@+id/tvDoorIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:text="🚪"
                    android:textSize="14sp" />
                
                <TextView
                    android:id="@+id/tvDoorStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Закрыто"
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
            
            <!-- Зарядка -->
            <LinearLayout
                android:id="@+id/layoutCharging"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp"
                android:visibility="gone">
                
                <TextView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:text="⚡"
                    android:textSize="14sp" />
                
                <TextView
                    android:id="@+id/tvChargingStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Зарядка"
                    android:textSize="12sp"
                    android:textColor="@color/warning" />
            </LinearLayout>
            
        </LinearLayout>
        
    </com.google.android.material.card.MaterialCardView>

    <!-- Нижняя панель навигации -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:padding="16dp">
        
        <!-- Быстрые кнопки -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="16dp">
            
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHome"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Дом"
                app:icon="@drawable/ic_home" />
            
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFavorites"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Избранное"
                app:icon="@drawable/ic_favorite" />
            
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMenu"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Меню"
                app:icon="@drawable/ic_menu" />
            
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCharging"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Зарядка"
                app:icon="@drawable/ic_charging_station" />
            
        </LinearLayout>
        
        <!-- Кнопка начала навигации -->
        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/fabNavigate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="В путь"
            android:visibility="gone"
            app:icon="@drawable/ic_navigation" />
        
    </LinearLayout>

    <!-- Кнопка центрирования на местоположении -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabMyLocation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="140dp"
        android:contentDescription="Моё местоположение"
        app:srcCompat="@drawable/ic_my_location"
        app:fabSize="mini"
        app:backgroundTint="@color/surface"
        app:tint="@color/primary" />
    
    <!-- Карточка ближайшей зарядной станции -->
    <include
        layout="@layout/view_nearest_charging"
        android:id="@+id/viewNearestCharging" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
