<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Location permissions -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    
    <!-- Storage for offline maps -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Hardware features -->
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.type.automotive" android:required="false" />
    
    <!-- Car API permissions for reading vehicle data -->
    <uses-permission android:name="android.permission.ACCESS_FINE_VEHICLE_STATE" />
    <uses-permission android:name="android.permission.READ_VEHICLE_DIAGNOSTIC_DATA" />
    <uses-permission android:name="android.car.permission.CAR_ENERGY_PORTS" />
    <uses-permission android:name="android.car.permission.CAR_POWER" />
    <uses-permission android:name="android.car.permission.CAR_SPEED" />
    <uses-permission android:name="android.car.permission.CAR_ENERGY" />
    <uses-permission android:name="android.car.permission.CAR_INFO" />
    <uses-permission android:name="android.car.permission.READ_CAR_DIAGNOSTIC_DATA" />

    <application
        android:name=".OSMNavApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.OSMNavigator"
        android:usesCleartextTraffic="true"
        android:hardwareAccelerated="true"
        tools:targetApi="31">
        
        <!-- Главная активность -->
        <activity
            android:name=".presentation.main.MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.OSMNavigator">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
        <!-- Поиск -->
        <activity
            android:name=".presentation.search.SearchActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:parentActivityName=".presentation.main.MainActivity" />
            
        <!-- Навигация -->
        <activity
            android:name=".presentation.navigation.NavigationActivity"
            android:exported="false"
            android:parentActivityName=".presentation.main.MainActivity"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|screenLayout|screenSize|orientation"
            android:launchMode="singleTop" />
            
        <!-- Настройки -->
        <activity
            android:name=".presentation.settings.SettingsActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:parentActivityName=".presentation.main.MainActivity" />

        <!-- AIDL Navigation Service для трансляции на приборную панель (AutoNavi protocol) -->
        <service
            android:name=".presentation.dashboard.NaviAIDLService"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.astrob.turbodog.NAVI_AIDL_SERVICE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

    </application>

</manifest>
