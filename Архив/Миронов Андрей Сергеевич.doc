\trowd\cellx9638\pard\intbl\itap1\sl220{\fs22\uc0\u1042 \uc0\u1099 \uc0\u1089 \uc0\u1096 \uc0\u1077 \uc0\u1077 }\cell\row\trowd\cellx1800\cellx9638\pard\intbl\itap1\sl220{\fs16\cf3 2007\line \uc0\u1042 \uc0\u1099 \uc0\u1089 \uc0\u1096 \uc0\u1077 \uc0\u1077 }\cell
\pard\intbl\itap1\sl280{\fs24\b \uc0\u1052 \uc0\u1086 \uc0\u1089 \uc0\u1082 \uc0\u1086 \uc0\u1074 \uc0\u1089 \uc0\u1082 \uc0\u1080 \uc0\u1081  \uc0\u1075 \uc0\u1086 \uc0\u1089 \uc0\u1091 \uc0\u1076 \uc0\u1072 \uc0\u1088 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1077 \uc0\u1085 \uc0\u1085 \uc0\u1099 \uc0\u1081  \uc0\u1080 \uc0\u1085 \uc0\u1076 \uc0\u1091 \uc0\u1089 \uc0\u1090 \uc0\u1088 \uc0\u1080 \uc0\u1072 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1099 \uc0\u1081  \uc0\u1091 \uc0\u1085 \uc0\u1080 \uc0\u1074 \uc0\u1077 \uc0\u1088 \uc0\u1089 \uc0\u1080 \uc0\u1090 \uc0\u1077 \uc0\u1090 , \uc0\u1052 \uc0\u1086 \uc0\u1089 \uc0\u1082 \uc0\u1074 \uc0\u1072 }\par
\pard\intbl\itap1\sl260{\fs18 \uc0\u1055 \uc0\u1088 \uc0\u1080 \uc0\u1082 \uc0\u1083 \uc0\u1072 \uc0\u1076 \uc0\u1085 \uc0\u1072 \uc0\u1103  \uc0\u1080 \uc0\u1085 \uc0\u1092 \uc0\u1086 \uc0\u1088 \uc0\u1084 \uc0\u1072 \uc0\u1090 \uc0\u1080 \uc0\u1082 \uc0\u1072  \uc0\u1074  \uc0\u1101 \uc0\u1082 \uc0\u1086 \uc0\u1085 \uc0\u1086 \uc0\u1084 \uc0\u1080 \uc0\u1082 \uc0\u1077 , \uc0\u1055 \uc0\u1088 \uc0\u1086 \uc0\u1080 \uc0\u1079 \uc0\u1074 \uc0\u1086 \uc0\u1076 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1077 \uc0\u1085 \uc0\u1085 \uc0\u1099 \uc0\u1081  \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1077 \uc0\u1076 \uc0\u1078 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1090 }
\cell\row



\trowd\cellx9638\pard\intbl\itap1\sa150\sb500\brdrb\brdrs\brdrcf2{\fs22\cf1 \uc0\u1053 \uc0\u1072 \uc0\u1074 \uc0\u1099 \uc0\u1082 \uc0\u1080 }\cell\row

\trowd\cellx1800\cellx9638\pard\intbl\itap1\sl220{\fs16\cf3 \uc0\u1047 \uc0\u1085 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1103 \uc0\u1079 \uc0\u1099 \uc0\u1082 \uc0\u1086 \uc0\u1074 }\cell
\pard\intbl\itap1\sl260{\fs18
\uc0\u1056 \uc0\u1091 \uc0\u1089 \uc0\u1089 \uc0\u1082 \uc0\u1080 \uc0\u1081  {\cf1\emdash  \uc0\u1056 \uc0\u1086 \uc0\u1076 \uc0\u1085 \uc0\u1086 \uc0\u1081 }
}\cell\row

\trowd\cellx1800\cellx9638\pard\intbl\itap1\sb250\sl220{\fs16\cf3 \uc0\u1053 \uc0\u1072 \uc0\u1074 \uc0\u1099 \uc0\u1082 \uc0\u1080 }\cell
\pard\intbl\itap1\sl260{\fs18
{\cb5\chcfpat5\chcbpat5 Agile\~Project\~Management}  {\cb5\chcfpat5\chcbpat5 \uc0\u1041 \uc0\u1080 \uc0\u1079 \uc0\u1085 \uc0\u1077 \uc0\u1089 -\uc0\u1087 \uc0\u1083 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1077 }  {\cb5\chcfpat5\chcbpat5 \uc0\u1041 \uc0\u1102 \uc0\u1076 \uc0\u1078 \uc0\u1077 \uc0\u1090 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1077 }  {\cb5\chcfpat5\chcbpat5 \uc0\u1041 \uc0\u1080 \uc0\u1079 \uc0\u1085 \uc0\u1077 \uc0\u1089 -\uc0\u1072 \uc0\u1085 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1079 }  {\cb5\chcfpat5\chcbpat5 Scrum}  {\cb5\chcfpat5\chcbpat5 \uc0\u1047 \uc0\u1072 \uc0\u1087 \uc0\u1091 \uc0\u1089 \uc0\u1082 \~\uc0\u1085 \uc0\u1086 \uc0\u1074 \uc0\u1099 \uc0\u1093 \~\uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1076 \uc0\u1091 \uc0\u1082 \uc0\u1090 \uc0\u1086 \uc0\u1074 }  {\cb5\chcfpat5\chcbpat5 \uc0\u1059 \uc0\u1087 \uc0\u1088 \uc0\u1072 \uc0\u1074 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077 \~\uc0\u1087 \uc0\u1077 \uc0\u1088 \uc0\u1089 \uc0\u1086 \uc0\u1085 \uc0\u1072 \uc0\u1083 \uc0\u1086 \uc0\u1084 }  {\cb5\chcfpat5\chcbpat5 \uc0\u1059 \uc0\u1087 \uc0\u1088 \uc0\u1072 \uc0\u1074 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077 \~\uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1072 \uc0\u1084 \uc0\u1080 }  {\cb5\chcfpat5\chcbpat5 \uc0\u1059 \uc0\u1087 \uc0\u1088 \uc0\u1072 \uc0\u1074 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077 \~\uc0\u1088 \uc0\u1080 \uc0\u1089 \uc0\u1082 \uc0\u1072 \uc0\u1084 \uc0\u1080 }  {\cb5\chcfpat5\chcbpat5 \uc0\u1059 \uc0\u1087 \uc0\u1088 \uc0\u1072 \uc0\u1074 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077 \~\uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1072 \uc0\u1085 \uc0\u1076 \uc0\u1086 \uc0\u1081 }  {\cb5\chcfpat5\chcbpat5 \uc0\u1055 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1072 \uc0\u1085 \uc0\u1086 \uc0\u1074 \uc0\u1082 \uc0\u1072 \~\uc0\u1079 \uc0\u1072 \uc0\u1076 \uc0\u1072 \uc0\u1095 \~\uc0\u1088 \uc0\u1072 \uc0\u1079 \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1095 \uc0\u1080 \uc0\u1082 \uc0\u1072 \uc0\u1084 }  {\cb5\chcfpat5\chcbpat5 PMBOK}  {\cb5\chcfpat5\chcbpat5 \uc0\u1051 \uc0\u1080 \uc0\u1076 \uc0\u1077 \uc0\u1088 \uc0\u1089 \uc0\u1082 \uc0\u1080 \uc0\u1077 \~\uc0\u1082 \uc0\u1072 \uc0\u1095 \uc0\u1077 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1072 }  {\cb5\chcfpat5\chcbpat5 \uc0\u1054 \uc0\u1088 \uc0\u1075 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1079 \uc0\u1072 \uc0\u1090 \uc0\u1086 \uc0\u1088 \uc0\u1089 \uc0\u1082 \uc0\u1080 \uc0\u1077 \~\uc0\u1085 \uc0\u1072 \uc0\u1074 \uc0\u1099 \uc0\u1082 \uc0\u1080 }  {\cb5\chcfpat5\chcbpat5 \uc0\u1059 \uc0\u1087 \uc0\u1088 \uc0\u1072 \uc0\u1074 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077 \~\uc0\u1073 \uc0\u1101 \uc0\u1082 \uc0\u1083 \uc0\u1086 \uc0\u1075 \uc0\u1086 \uc0\u1084 }  {\cb5\chcfpat5\chcbpat5 Unit-\uc0\u1101 \uc0\u1082 \uc0\u1086 \uc0\u1085 \uc0\u1086 \uc0\u1084 \uc0\u1080 \uc0\u1082 \uc0\u1072 }  {\cb5\chcfpat5\chcbpat5 \uc0\u1055 \uc0\u1088 \uc0\u1086 \uc0\u1090 \uc0\u1086 \uc0\u1090 \uc0\u1080 \uc0\u1087 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1077 }}\cell\row

\trowd\cellx9638\pard\intbl\itap1\sa150\sb500\brdrb\brdrs\brdrcf2{\fs22\cf1 \uc0\u1054 \uc0\u1087 \uc0\u1099 \uc0\u1090  \uc0\u1074 \uc0\u1086 \uc0\u1078 \uc0\u1076 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103 }\cell\row

\trowd\cellx9638\pard\intbl\itap1\sa100\sl280{\fs18
\uc0\u1048 \uc0\u1084 \uc0\u1077 \uc0\u1077 \uc0\u1090 \uc0\u1089 \uc0\u1103  \uc0\u1089 \uc0\u1086 \uc0\u1073 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1077 \uc0\u1085 \uc0\u1085 \uc0\u1099 \uc0\u1081  \uc0\u1072 \uc0\u1074 \uc0\u1090 \uc0\u1086 \uc0\u1084 \uc0\u1086 \uc0\u1073 \uc0\u1080 \uc0\u1083 \uc0\u1100 \par
\uc0\u1055 \uc0\u1088 \uc0\u1072 \uc0\u1074 \uc0\u1072  \uc0\u1082 \uc0\u1072 \uc0\u1090 \uc0\u1077 \uc0\u1075 \uc0\u1086 \uc0\u1088 \uc0\u1080 \uc0\u1080  B
}\cell\row
\trowd\cellx9638\pard\intbl\itap1\sa150\sb500\brdrb\brdrs\brdrcf2{\fs22\cf1 \uc0\u1044 \uc0\u1086 \uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1085 \uc0\u1080 \uc0\u1090 \uc0\u1077 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1072 \uc0\u1103  \uc0\u1080 \uc0\u1085 \uc0\u1092 \uc0\u1086 \uc0\u1088 \uc0\u1084 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1103 }\cell\row

\trowd\cellx1800\cellx9638\pard\intbl\itap1\sl220{\fs16\cf3 \uc0\u1056 \uc0\u1077 \uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1076 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1080 }\cell
\pard\intbl\itap1\sl260{\fs18
\uc0\u1055 \uc0\u1040 \uc0\u1054  \uc0\u1057 \uc0\u1073 \uc0\u1077 \uc0\u1088 \uc0\u1073 \uc0\u1072 \uc0\u1085 \uc0\u1082 \par
{\cf1 \uc0\u1064 \uc0\u1072 \uc0\u1073 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1085  \uc0\u1042 \uc0\u1083 \uc0\u1072 \uc0\u1076 \uc0\u1080 \uc0\u1084 \uc0\u1080 \uc0\u1088  \uc0\u1045 \uc0\u1074 \uc0\u1075 \uc0\u1077 \uc0\u1085 \uc0\u1100 \uc0\u1077 \uc0\u1074 \uc0\u1080 \uc0\u1095  (\uc0\u1059 \uc0\u1087 \uc0\u1088 \uc0\u1072 \uc0\u1074 \uc0\u1083 \uc0\u1103 \uc0\u1102 \uc0\u1097 \uc0\u1080 \uc0\u1081  \uc0\u1076 \uc0\u1080 \uc0\u1088 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1086 \uc0\u1088  - \uc0\u1085 \uc0\u1072 \uc0\u1095 \uc0\u1072 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1080 \uc0\u1082  \uc0\u1091 \uc0\u1087 \uc0\u1088 \uc0\u1072 \uc0\u1074 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103 )}
\par\par \uc0\u1047 \uc0\u1040 \uc0\u1054  \uc0\u1048 \uc0\u1085 \uc0\u1092 \uc0\u1086 \uc0\u1089 \uc0\u1080 \uc0\u1089 \uc0\u1090 \uc0\u1077 \uc0\u1084 \uc0\u1099  \uc0\u1044 \uc0\u1078 \uc0\u1077 \uc0\u1090 \par
{\cf1 \uc0\u1057 \uc0\u1072 \uc0\u1084 \uc0\u1086 \uc0\u1081 \uc0\u1083 \uc0\u1086 \uc0\u1074  \uc0\u1040 \uc0\u1085 \uc0\u1076 \uc0\u1088 \uc0\u1077 \uc0\u1081  \uc0\u1048 \uc0\u1075 \uc0\u1086 \uc0\u1088 \uc0\u1077 \uc0\u1074 \uc0\u1080 \uc0\u1095  (\uc0\u1044 \uc0\u1080 \uc0\u1088 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1086 \uc0\u1088  \uc0\u1076 \uc0\u1077 \uc0\u1087 \uc0\u1072 \uc0\u1088 \uc0\u1090 \uc0\u1072 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1072  \uc0\u1087 \uc0\u1086  \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1077  \uc0\u1089  \uc0\u1086 \uc0\u1088 \uc0\u1075 \uc0\u1072 \uc0\u1085 \uc0\u1072 \uc0\u1084 \uc0\u1072  \uc0\u1075 \uc0\u1086 \uc0\u1089 \uc0\u1091 \uc0\u1076 \uc0\u1072 \uc0\u1088 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1077 \uc0\u1085 \uc0\u1085 \uc0\u1086 \uc0\u1081  \uc0\u1074 \uc0\u1083 \uc0\u1072 \uc0\u1089 \uc0\u1090 \uc0\u1080 )}
\par\par \uc0\u1054 \uc0\u1054 \uc0\u1054  \uc0\u1058 \uc0\u1077 \uc0\u1083 \uc0\u1077 \uc0\u1082 \uc0\u1086 \uc0\u1084  \uc0\u1048 \uc0\u1085 \uc0\u1092 \uc0\u1086  \uc0\u1055 \uc0\u1088 \uc0\u1086 \uc0\u1077 \uc0\u1082 \uc0\u1090 \par
{\cf1 \uc0\u1051 \uc0\u1099 \uc0\u1095 \uc0\u1082 \uc0\u1086 \uc0\u1074  \uc0\u1040 \uc0\u1085 \uc0\u1076 \uc0\u1088 \uc0\u1077 \uc0\u1081  \uc0\u1053 \uc0\u1080 \uc0\u1082 \uc0\u1086 \uc0\u1083 \uc0\u1072 \uc0\u1077 \uc0\u1074 \uc0\u1080 \uc0\u1095  (\uc0\u1047 \uc0\u1072 \uc0\u1084 \uc0\u1077 \uc0\u1089 \uc0\u1090 \uc0\u1080 \uc0\u1090 \uc0\u1077 \uc0\u1083 \uc0\u1100  \uc0\u1075 \uc0\u1077 \uc0\u1085 \uc0\u1077 \uc0\u1088 \uc0\u1072 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1086 \uc0\u1075 \uc0\u1086  \uc0\u1076 \uc0\u1080 \uc0\u1088 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1086 \uc0\u1088 \uc0\u1072 )}
}\cell\row

\trowd\cellx1800\cellx9638\pard\intbl\itap1\sb250\sl220{\fs16\cf3 \uc0\u1054 \uc0\u1073 \uc0\u1086  \uc0\u1084 \uc0\u1085 \uc0\u1077 }\cell
\pard\intbl\itap1\sb250\sl260{\fs18 \uc0\u1045 \uc0\u1089 \uc0\u1090 \uc0\u1100  \uc0\u1080 \uc0\u1076 \uc0\u1077 \uc0\u1103  \uc0\u1080 \uc0\u1083 \uc0\u1080  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1073 \uc0\u1083 \uc0\u1077 \uc0\u1084 \uc0\u1072  \uc0\u1080  \uc0\u1085 \uc0\u1077  \uc0\u1079 \uc0\u1085 \uc0\u1072 \uc0\u1077 \uc0\u1090 \uc0\u1077 , \uc0\u1095 \uc0\u1090 \uc0\u1086  \uc0\u1076 \uc0\u1077 \uc0\u1083 \uc0\u1072 \uc0\u1090 \uc0\u1100  \uc0\u1076 \uc0\u1072 \uc0\u1083 \uc0\u1100 \uc0\u1096 \uc0\u1077 ? \uc0\u1071  \uc0\u1089 \uc0\u1075 \uc0\u1077 \uc0\u1085 \uc0\u1077 \uc0\u1088 \uc0\u1080 \uc0\u1088 \uc0\u1091 \uc0\u1102  \uc0\u1075 \uc0\u1080 \uc0\u1087 \uc0\u1086 \uc0\u1090 \uc0\u1077 \uc0\u1079 \uc0\u1099 , \uc0\u1088 \uc0\u1072 \uc0\u1079 \uc0\u1073 \uc0\u1077 \uc0\u1088 \uc0\u1091  \uc0\u1080 \uc0\u1076 \uc0\u1077 \uc0\u1102  \uc0\u1085 \uc0\u1072  \uc0\u1092 \uc0\u1080 \uc0\u1095 \uc0\u1080 , \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1077 \uc0\u1088 \uc0\u1102  \uc0\u1075 \uc0\u1080 \uc0\u1087 \uc0\u1086 \uc0\u1090 \uc0\u1077 \uc0\u1079 \uc0\u1099 , \uc0\u1089 \uc0\u1092 \uc0\u1086 \uc0\u1088 \uc0\u1084 \uc0\u1080 \uc0\u1088 \uc0\u1091 \uc0\u1102  \uc0\u1073 \uc0\u1101 \uc0\u1082 \uc0\u1083 \uc0\u1086 \uc0\u1075 , \uc0\u1087 \uc0\u1086 \uc0\u1076 \uc0\u1073 \uc0\u1077 \uc0\u1088 \uc0\u1091  \uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1072 \uc0\u1085 \uc0\u1076 \uc0\u1091  \uc0\u1080  \uc0\u1079 \uc0\u1072 \uc0\u1087 \uc0\u1091 \uc0\u1097 \uc0\u1091  \uc0\u1080 \uc0\u1076 \uc0\u1077 \uc0\u1102  \uc0\u1074  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1076 .{\line}{\line}\uc0\u1054 \uc0\u1087 \uc0\u1099 \uc0\u1090 \uc0\u1085 \uc0\u1099 \uc0\u1081  Product Owner \uc0\u1080  CPO \uc0\u1089  \uc0\u1073 \uc0\u1086 \uc0\u1083 \uc0\u1077 \uc0\u1077  \uc0\u1095 \uc0\u1077 \uc0\u1084  10-\uc0\u1083 \uc0\u1077 \uc0\u1090 \uc0\u1085 \uc0\u1080 \uc0\u1084  \uc0\u1089 \uc0\u1090 \uc0\u1072 \uc0\u1078 \uc0\u1077 \uc0\u1084  \uc0\u1091 \uc0\u1087 \uc0\u1088 \uc0\u1072 \uc0\u1074 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1094 \uc0\u1080 \uc0\u1092 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1086 \uc0\u1081  \uc0\u1090 \uc0\u1088 \uc0\u1072 \uc0\u1085 \uc0\u1089 \uc0\u1092 \uc0\u1086 \uc0\u1088 \uc0\u1084 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1077 \uc0\u1081  \uc0\u1074  \uc0\u1082 \uc0\u1088 \uc0\u1091 \uc0\u1087 \uc0\u1085 \uc0\u1077 \uc0\u1081 \uc0\u1096 \uc0\u1080 \uc0\u1093  \uc0\u1092 \uc0\u1080 \uc0\u1085 \uc0\u1072 \uc0\u1085 \uc0\u1089 \uc0\u1086 \uc0\u1074 \uc0\u1099 \uc0\u1093  \uc0\u1086 \uc0\u1088 \uc0\u1075 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1079 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1103 \uc0\u1093  (\uc0\u1057 \uc0\u1073 \uc0\u1077 \uc0\u1088 , \uc0\u1041 \uc0\u1072 \uc0\u1085 \uc0\u1082  \uc0\u1044 \uc0\u1054 \uc0\u1052 .\uc0\u1056 \uc0\u1060 ). \uc0\u1057 \uc0\u1087 \uc0\u1077 \uc0\u1094 \uc0\u1080 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1079 \uc0\u1080 \uc0\u1088 \uc0\u1091 \uc0\u1102 \uc0\u1089 \uc0\u1100  \uc0\u1085 \uc0\u1072  \uc0\u1079 \uc0\u1072 \uc0\u1087 \uc0\u1091 \uc0\u1089 \uc0\u1082 \uc0\u1077  \uc0\u1080 \uc0\u1085 \uc0\u1085 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1086 \uc0\u1085 \uc0\u1085 \uc0\u1099 \uc0\u1093  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1076 \uc0\u1091 \uc0\u1082 \uc0\u1090 \uc0\u1086 \uc0\u1074  \uc0\u1089  \uc0\u1085 \uc0\u1091 \uc0\u1083 \uc0\u1103  (\uc0\u1086 \uc0\u1090  \uc0\u1087 \uc0\u1086 \uc0\u1080 \uc0\u1089 \uc0\u1082 \uc0\u1072  \uc0\u1080  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1077 \uc0\u1088 \uc0\u1082 \uc0\u1080  \uc0\u1075 \uc0\u1080 \uc0\u1087 \uc0\u1086 \uc0\u1090 \uc0\u1077 \uc0\u1079 \uc0\u1099  \uc0\u1076 \uc0\u1086  \uc0\u1074 \uc0\u1085 \uc0\u1077 \uc0\u1076 \uc0\u1088 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1088 \uc0\u1077 \uc0\u1096 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1074  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1076 ), \uc0\u1074 \uc0\u1085 \uc0\u1077 \uc0\u1076 \uc0\u1088 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1080  \uc0\u1048 \uc0\u1048 -\uc0\u1090 \uc0\u1077 \uc0\u1093 \uc0\u1085 \uc0\u1086 \uc0\u1083 \uc0\u1086 \uc0\u1075 \uc0\u1080 \uc0\u1081  \uc0\u1080  \uc0\u1091 \uc0\u1087 \uc0\u1088 \uc0\u1072 \uc0\u1074 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1080  \uc0\u1084 \uc0\u1072 \uc0\u1089 \uc0\u1096 \uc0\u1090 \uc0\u1072 \uc0\u1073 \uc0\u1085 \uc0\u1099 \uc0\u1084 \uc0\u1080  \uc0\u1082 \uc0\u1088 \uc0\u1086 \uc0\u1089 \uc0\u1089 -\uc0\u1092 \uc0\u1091 \uc0\u1085 \uc0\u1082 \uc0\u1094 \uc0\u1080 \uc0\u1086 \uc0\u1085 \uc0\u1072 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1099 \uc0\u1084 \uc0\u1080  \uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1072 \uc0\u1085 \uc0\u1076 \uc0\u1072 \uc0\u1084 \uc0\u1080 . \uc0\u1054 \uc0\u1073 \uc0\u1083 \uc0\u1072 \uc0\u1076 \uc0\u1072 \uc0\u1102  \uc0\u1075 \uc0\u1083 \uc0\u1091 \uc0\u1073 \uc0\u1086 \uc0\u1082 \uc0\u1086 \uc0\u1081  \uc0\u1101 \uc0\u1082 \uc0\u1089 \uc0\u1087 \uc0\u1077 \uc0\u1088 \uc0\u1090 \uc0\u1080 \uc0\u1079 \uc0\u1086 \uc0\u1081  \uc0\u1074  \uc0\u1088 \uc0\u1072 \uc0\u1079 \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1082 \uc0\u1077  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1076 \uc0\u1091 \uc0\u1082 \uc0\u1090 \uc0\u1086 \uc0\u1074 \uc0\u1099 \uc0\u1093  \uc0\u1089 \uc0\u1090 \uc0\u1088 \uc0\u1072 \uc0\u1090 \uc0\u1077 \uc0\u1075 \uc0\u1080 \uc0\u1081  \uc0\u1094 \uc0\u1080 \uc0\u1092 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1099 \uc0\u1093  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1076 \uc0\u1091 \uc0\u1082 \uc0\u1090 \uc0\u1086 \uc0\u1074  (\uc0\u1085 \uc0\u1072 \uc0\u1093 \uc0\u1086 \uc0\u1078 \uc0\u1091  \uc0\u1090 \uc0\u1086 \uc0\u1095 \uc0\u1082 \uc0\u1080  \uc0\u1089 \uc0\u1086 \uc0\u1087 \uc0\u1088 \uc0\u1080 \uc0\u1082 \uc0\u1086 \uc0\u1089 \uc0\u1085 \uc0\u1086 \uc0\u1074 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1073 \uc0\u1080 \uc0\u1079 \uc0\u1085 \uc0\u1077 \uc0\u1089  \uc0\u1094 \uc0\u1077 \uc0\u1083 \uc0\u1077 \uc0\u1081 , \uc0\u1074 \uc0\u1086 \uc0\u1079 \uc0\u1084 \uc0\u1086 \uc0\u1078 \uc0\u1085 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1077 \uc0\u1081  \uc0\u1086 \uc0\u1088 \uc0\u1075 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1079 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1080  \uc0\u1080  \uc0\u1094 \uc0\u1080 \uc0\u1092 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1080 \uc0\u1079 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1080 ), \uc0\u1091 \uc0\u1087 \uc0\u1088 \uc0\u1072 \uc0\u1074 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1080  R&D-\uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1072 \uc0\u1084 \uc0\u1080  \uc0\u1080  \uc0\u1086 \uc0\u1087 \uc0\u1090 \uc0\u1080 \uc0\u1084 \uc0\u1080 \uc0\u1079 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1080  \uc0\u1073 \uc0\u1080 \uc0\u1079 \uc0\u1085 \uc0\u1077 \uc0\u1089 -\uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1094 \uc0\u1077 \uc0\u1089 \uc0\u1089 \uc0\u1086 \uc0\u1074 , \uc0\u1095 \uc0\u1090 \uc0\u1086  \uc0\u1087 \uc0\u1086 \uc0\u1079 \uc0\u1074 \uc0\u1086 \uc0\u1083 \uc0\u1103 \uc0\u1077 \uc0\u1090  \uc0\u1082 \uc0\u1088 \uc0\u1072 \uc0\u1090 \uc0\u1085 \uc0\u1086  \uc0\u1089 \uc0\u1086 \uc0\u1082 \uc0\u1088 \uc0\u1072 \uc0\u1097 \uc0\u1072 \uc0\u1090 \uc0\u1100  \uc0\u1086 \uc0\u1087 \uc0\u1077 \uc0\u1088 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1086 \uc0\u1085 \uc0\u1085 \uc0\u1099 \uc0\u1077  \uc0\u1088 \uc0\u1072 \uc0\u1089 \uc0\u1093 \uc0\u1086 \uc0\u1076 \uc0\u1099  \uc0\u1080  \uc0\u1074 \uc0\u1099 \uc0\u1074 \uc0\u1086 \uc0\u1076 \uc0\u1080 \uc0\u1090 \uc0\u1100  MVP \uc0\u1085 \uc0\u1072  \uc0\u1088 \uc0\u1099 \uc0\u1085 \uc0\u1086 \uc0\u1082  \uc0\u1074  \uc0\u1089 \uc0\u1078 \uc0\u1072 \uc0\u1090 \uc0\u1099 \uc0\u1077  \uc0\u1089 \uc0\u1088 \uc0\u1086 \uc0\u1082 \uc0\u1080 .{\line}{\line}\uc0\u1047 \uc0\u1072  \uc0\u1074 \uc0\u1088 \uc0\u1077 \uc0\u1084 \uc0\u1103  \uc0\u1082 \uc0\u1072 \uc0\u1088 \uc0\u1100 \uc0\u1077 \uc0\u1088 \uc0\u1099  \uc0\u1091 \uc0\u1089 \uc0\u1087 \uc0\u1077 \uc0\u1096 \uc0\u1085 \uc0\u1086  \uc0\u1088 \uc0\u1077 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1079 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1083  \uc0\u1088 \uc0\u1103 \uc0\u1076  \uc0\u1089 \uc0\u1090 \uc0\u1088 \uc0\u1072 \uc0\u1090 \uc0\u1077 \uc0\u1075 \uc0\u1080 \uc0\u1095 \uc0\u1077 \uc0\u1089 \uc0\u1082 \uc0\u1080 \uc0\u1093  \uc0\u1080 \uc0\u1085 \uc0\u1080 \uc0\u1094 \uc0\u1080 \uc0\u1072 \uc0\u1090 \uc0\u1080 \uc0\u1074 : \uc0\u1086 \uc0\u1090  \uc0\u1074 \uc0\u1085 \uc0\u1077 \uc0\u1076 \uc0\u1088 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1082 \uc0\u1086 \uc0\u1089 \uc0\u1084 \uc0\u1080 \uc0\u1095 \uc0\u1077 \uc0\u1089 \uc0\u1082 \uc0\u1080 \uc0\u1093  \uc0\u1090 \uc0\u1077 \uc0\u1093 \uc0\u1085 \uc0\u1086 \uc0\u1083 \uc0\u1086 \uc0\u1075 \uc0\u1080 \uc0\u1081  \uc0\u1084 \uc0\u1086 \uc0\u1085 \uc0\u1080 \uc0\u1090 \uc0\u1086 \uc0\u1088 \uc0\u1080 \uc0\u1085 \uc0\u1075 \uc0\u1072  (\uc0\u1086 \uc0\u1090  \uc0\u1075 \uc0\u1080 \uc0\u1087 \uc0\u1086 \uc0\u1090 \uc0\u1077 \uc0\u1079 \uc0\u1099  \uc0\u1076 \uc0\u1086  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1076 \uc0\u1072  3 \uc0\u1084 \uc0\u1077 \uc0\u1089 \uc0\u1103 \uc0\u1094 \uc0\u1072 ) \uc0\u1076 \uc0\u1086  \uc0\u1079 \uc0\u1072 \uc0\u1097 \uc0\u1080 \uc0\u1090 \uc0\u1099  \uc0\u1076 \uc0\u1086 \uc0\u1088 \uc0\u1086 \uc0\u1078 \uc0\u1085 \uc0\u1099 \uc0\u1093  \uc0\u1082 \uc0\u1072 \uc0\u1088 \uc0\u1090  \uc0\u1087 \uc0\u1086  \uc0\u1080 \uc0\u1089 \uc0\u1082 \uc0\u1091 \uc0\u1089 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1077 \uc0\u1085 \uc0\u1085 \uc0\u1086 \uc0\u1084 \uc0\u1091  \uc0\u1080 \uc0\u1085 \uc0\u1090 \uc0\u1077 \uc0\u1083 \uc0\u1083 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1091  \uc0\u1087 \uc0\u1077 \uc0\u1088 \uc0\u1077 \uc0\u1076  \uc0\u1090 \uc0\u1086 \uc0\u1087 -\uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1077 \uc0\u1076 \uc0\u1078 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1086 \uc0\u1084  (\uc0\u1086 \uc0\u1090  \uc0\u1075 \uc0\u1080 \uc0\u1087 \uc0\u1086 \uc0\u1090 \uc0\u1077 \uc0\u1079 \uc0\u1099  \uc0\u1076 \uc0\u1086  \uc0\u1079 \uc0\u1072 \uc0\u1097 \uc0\u1080 \uc0\u1090 \uc0\u1099  1 \uc0\u1084 \uc0\u1077 \uc0\u1089 \uc0\u1103 \uc0\u1094 ). \uc0\u1057 \uc0\u1074 \uc0\u1086 \uc0\u1073 \uc0\u1086 \uc0\u1076 \uc0\u1085 \uc0\u1086  \uc0\u1074 \uc0\u1083 \uc0\u1072 \uc0\u1076 \uc0\u1077 \uc0\u1102  \uc0\u1084 \uc0\u1077 \uc0\u1090 \uc0\u1086 \uc0\u1076 \uc0\u1086 \uc0\u1083 \uc0\u1086 \uc0\u1075 \uc0\u1080 \uc0\u1103 \uc0\u1084 \uc0\u1080  Agile \uc0\u1080  Scrum, \uc0\u1091 \uc0\u1084 \uc0\u1077 \uc0\u1102  \uc0\u1074 \uc0\u1099 \uc0\u1089 \uc0\u1090 \uc0\u1088 \uc0\u1072 \uc0\u1080 \uc0\u1074 \uc0\u1072 \uc0\u1090 \uc0\u1100  \uc0\u1101 \uc0\u1092 \uc0\u1092 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1080 \uc0\u1074 \uc0\u1085 \uc0\u1099 \uc0\u1077  \uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1084 \uc0\u1091 \uc0\u1085 \uc0\u1080 \uc0\u1082 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1080  \uc0\u1084 \uc0\u1077 \uc0\u1078 \uc0\u1076 \uc0\u1091  \uc0\u1073 \uc0\u1080 \uc0\u1079 \uc0\u1085 \uc0\u1077 \uc0\u1089 \uc0\u1086 \uc0\u1084  \uc0\u1080  \uc0\u1048 \uc0\u1058 -\uc0\u1088 \uc0\u1072 \uc0\u1079 \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1082 \uc0\u1086 \uc0\u1081 , \uc0\u1086 \uc0\u1073 \uc0\u1077 \uc0\u1089 \uc0\u1087 \uc0\u1077 \uc0\u1095 \uc0\u1080 \uc0\u1074 \uc0\u1072 \uc0\u1103  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1079 \uc0\u1088 \uc0\u1072 \uc0\u1095 \uc0\u1085 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1100  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1094 \uc0\u1077 \uc0\u1089 \uc0\u1089 \uc0\u1086 \uc0\u1074  \uc0\u1085 \uc0\u1072  \uc0\u1074 \uc0\u1089 \uc0\u1077 \uc0\u1093  \uc0\u1101 \uc0\u1090 \uc0\u1072 \uc0\u1087 \uc0\u1072 \uc0\u1093  \uc0\u1078 \uc0\u1080 \uc0\u1079 \uc0\u1085 \uc0\u1077 \uc0\u1085 \uc0\u1085 \uc0\u1086 \uc0\u1075 \uc0\u1086  \uc0\u1094 \uc0\u1080 \uc0\u1082 \uc0\u1083 \uc0\u1072  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1076 \uc0\u1091 \uc0\u1082 \uc0\u1090 \uc0\u1072 . \uc0\u1056 \uc0\u1072 \uc0\u1079 \uc0\u1073 \uc0\u1080 \uc0\u1088 \uc0\u1072 \uc0\u1102 \uc0\u1089 \uc0\u1100  \uc0\u1074  \uc0\u1074 \uc0\u1086 \uc0\u1079 \uc0\u1084 \uc0\u1086 \uc0\u1078 \uc0\u1085 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1103 \uc0\u1093  \uc0\u1090 \uc0\u1077 \uc0\u1093 \uc0\u1085 \uc0\u1086 \uc0\u1083 \uc0\u1086 \uc0\u1075 \uc0\u1080 \uc0\u1080  \uc0\u1048 \uc0\u1048  (CV, ML, GenAI), \uc0\u1091 \uc0\u1084 \uc0\u1077 \uc0\u1102  \uc0\u1086 \uc0\u1087 \uc0\u1088 \uc0\u1077 \uc0\u1076 \uc0\u1077 \uc0\u1083 \uc0\u1103 \uc0\u1090 \uc0\u1100  \uc0\u1090 \uc0\u1088 \uc0\u1077 \uc0\u1073 \uc0\u1091 \uc0\u1077 \uc0\u1084 \uc0\u1091 \uc0\u1102  \uc0\u1090 \uc0\u1077 \uc0\u1093 \uc0\u1085 \uc0\u1086 \uc0\u1083 \uc0\u1086 \uc0\u1075 \uc0\u1080 \uc0\u1102  \uc0\u1076 \uc0\u1083 \uc0\u1103  \uc0\u1076 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1080 \uc0\u1078 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1094 \uc0\u1077 \uc0\u1083 \uc0\u1080 ; \uc0\u1093 \uc0\u1086 \uc0\u1088 \uc0\u1086 \uc0\u1096 \uc0\u1086  \uc0\u1087 \uc0\u1086 \uc0\u1085 \uc0\u1080 \uc0\u1084 \uc0\u1072 \uc0\u1102  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1080 \uc0\u1079 \uc0\u1074 \uc0\u1086 \uc0\u1076 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1077 \uc0\u1085 \uc0\u1085 \uc0\u1099 \uc0\u1081  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1094 \uc0\u1077 \uc0\u1089 \uc0\u1089  \uc0\u1089 \uc0\u1086 \uc0\u1079 \uc0\u1076 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1094 \uc0\u1080 \uc0\u1092 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1099 \uc0\u1093  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1076 \uc0\u1091 \uc0\u1082 \uc0\u1090 \uc0\u1086 \uc0\u1074  \uc0\u1086 \uc0\u1090  \uc0\u1075 \uc0\u1077 \uc0\u1085 \uc0\u1077 \uc0\u1088 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1080  \uc0\u1075 \uc0\u1080 \uc0\u1087 \uc0\u1086 \uc0\u1090 \uc0\u1077 \uc0\u1079 \uc0\u1099  \uc0\u1076 \uc0\u1086  \uc0\u1074 \uc0\u1099 \uc0\u1074 \uc0\u1086 \uc0\u1076 \uc0\u1072  \uc0\u1074  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1076 ; \uc0\u1087 \uc0\u1086 \uc0\u1085 \uc0\u1080 \uc0\u1084 \uc0\u1072 \uc0\u1102  \uc0\u1094 \uc0\u1077 \uc0\u1083 \uc0\u1080 , \uc0\u1079 \uc0\u1072 \uc0\u1076 \uc0\u1072 \uc0\u1095 \uc0\u1080  \uc0\u1080  \uc0\u1087 \uc0\u1088 \uc0\u1080 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1103 \uc0\u1077 \uc0\u1084 \uc0\u1099 \uc0\u1077  \uc0\u1080 \uc0\u1085 \uc0\u1089 \uc0\u1090 \uc0\u1088 \uc0\u1091 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1099  \uc0\u1091 \uc0\u1095 \uc0\u1072 \uc0\u1089 \uc0\u1090 \uc0\u1085 \uc0\u1080 \uc0\u1082 \uc0\u1086 \uc0\u1074  \uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1072 \uc0\u1085 \uc0\u1076 \uc0\u1099  \uc0\u1088 \uc0\u1072 \uc0\u1079 \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1082 \uc0\u1080  \uc0\u1080  \uc0\u1073 \uc0\u1080 \uc0\u1079 \uc0\u1085 \uc0\u1077 \uc0\u1089  \uc0\u1087 \uc0\u1086 \uc0\u1076 \uc0\u1088 \uc0\u1072 \uc0\u1079 \uc0\u1076 \uc0\u1077 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1081  (\uc0\u1086 \uc0\u1087 \uc0\u1099 \uc0\u1090  \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1099  \uc0\u1074  \uc0\u1088 \uc0\u1086 \uc0\u1083 \uc0\u1103 \uc0\u1093  \uc0\u1088 \uc0\u1072 \uc0\u1079 \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1095 \uc0\u1080 \uc0\u1082 , \uc0\u1072 \uc0\u1085 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1090 \uc0\u1080 \uc0\u1082 , \uc0\u1090 \uc0\u1077 \uc0\u1089 \uc0\u1090 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1097 \uc0\u1080 \uc0\u1082 , \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1077 \uc0\u1076 \uc0\u1078 \uc0\u1077 \uc0\u1088  \uc0\u1087 \uc0\u1086  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1076 \uc0\u1072 \uc0\u1078 \uc0\u1072 \uc0\u1084 , \uc0\u1089 \uc0\u1086 \uc0\u1073 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1077 \uc0\u1085 \uc0\u1085 \uc0\u1080 \uc0\u1082  \uc0\u1073 \uc0\u1080 \uc0\u1079 \uc0\u1085 \uc0\u1077 \uc0\u1089 \uc0\u1072 ), \uc0\u1095 \uc0\u1090 \uc0\u1086  \uc0\u1087 \uc0\u1086 \uc0\u1079 \uc0\u1074 \uc0\u1086 \uc0\u1083 \uc0\u1103 \uc0\u1077 \uc0\u1090  \uc0\u1086 \uc0\u1073 \uc0\u1097 \uc0\u1072 \uc0\u1090 \uc0\u1100 \uc0\u1089 \uc0\u1103  \uc0\u1089  \uc0\u1086 \uc0\u1073 \uc0\u1077 \uc0\u1080 \uc0\u1084 \uc0\u1080  \uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1072 \uc0\u1085 \uc0\u1076 \uc0\u1072 \uc0\u1084 \uc0\u1080  \uc0\u1085 \uc0\u1072  \uc0\u1086 \uc0\u1076 \uc0\u1085 \uc0\u1086 \uc0\u1084  \uc0\u1103 \uc0\u1079 \uc0\u1099 \uc0\u1082 \uc0\u1077 . {\line}{\line}\uc0\u1053 \uc0\u1072 \uc0\u1094 \uc0\u1077 \uc0\u1083 \uc0\u1077 \uc0\u1085  \uc0\u1085 \uc0\u1072  \uc0\u1088 \uc0\u1072 \uc0\u1079 \uc0\u1074 \uc0\u1080 \uc0\u1090 \uc0\u1080 \uc0\u1077  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1088 \uc0\u1099 \uc0\u1074 \uc0\u1085 \uc0\u1099 \uc0\u1093  \uc0\u1090 \uc0\u1077 \uc0\u1093 \uc0\u1085 \uc0\u1086 \uc0\u1083 \uc0\u1086 \uc0\u1075 \uc0\u1080 \uc0\u1095 \uc0\u1077 \uc0\u1089 \uc0\u1082 \uc0\u1080 \uc0\u1093  \uc0\u1088 \uc0\u1077 \uc0\u1096 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1081  \uc0\u1074  \uc0\u1086 \uc0\u1073 \uc0\u1083 \uc0\u1072 \uc0\u1089 \uc0\u1090 \uc0\u1080  \uc0\u1048 \uc0\u1048 , \uc0\u1073 \uc0\u1083 \uc0\u1086 \uc0\u1082 \uc0\u1095 \uc0\u1077 \uc0\u1081 \uc0\u1085 \uc0\u1072  \uc0\u1080 \uc0\u1083 \uc0\u1080  \uc0\u1082 \uc0\u1086 \uc0\u1089 \uc0\u1084 \uc0\u1080 \uc0\u1095 \uc0\u1077 \uc0\u1089 \uc0\u1082 \uc0\u1086 \uc0\u1081  \uc0\u1080 \uc0\u1085 \uc0\u1076 \uc0\u1091 \uc0\u1089 \uc0\u1090 \uc0\u1088 \uc0\u1080 \uc0\u1080  \uc0\u1074  \uc0\u1089 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1072 \uc0\u1074 \uc0\u1077  \uc0\u1089 \uc0\u1080 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1086 \uc0\u1081  \uc0\u1080  \uc0\u1072 \uc0\u1084 \uc0\u1073 \uc0\u1080 \uc0\u1094 \uc0\u1080 \uc0\u1086 \uc0\u1079 \uc0\u1085 \uc0\u1086 \uc0\u1081  \uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1072 \uc0\u1085 \uc0\u1076 \uc0\u1099 . \uc0\u1057 \uc0\u1086 \uc0\u1095 \uc0\u1077 \uc0\u1090 \uc0\u1072 \uc0\u1102  \uc0\u1089 \uc0\u1090 \uc0\u1088 \uc0\u1072 \uc0\u1090 \uc0\u1077 \uc0\u1075 \uc0\u1080 \uc0\u1095 \uc0\u1077 \uc0\u1089 \uc0\u1082 \uc0\u1086 \uc0\u1077  \uc0\u1074 \uc0\u1080 \uc0\u1076 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1089  \uc0\u1091 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077 \uc0\u1084  \uc0\u1075 \uc0\u1083 \uc0\u1091 \uc0\u1073 \uc0\u1086 \uc0\u1082 \uc0\u1086  \uc0\u1087 \uc0\u1086 \uc0\u1075 \uc0\u1088 \uc0\u1091 \uc0\u1078 \uc0\u1072 \uc0\u1090 \uc0\u1100 \uc0\u1089 \uc0\u1103  \uc0\u1074  \uc0\u1090 \uc0\u1077 \uc0\u1093 \uc0\u1085 \uc0\u1080 \uc0\u1095 \uc0\u1077 \uc0\u1089 \uc0\u1082 \uc0\u1080 \uc0\u1077  \uc0\u1076 \uc0\u1077 \uc0\u1090 \uc0\u1072 \uc0\u1083 \uc0\u1080  \uc0\u1080  \uc0\u1072 \uc0\u1088 \uc0\u1093 \uc0\u1080 \uc0\u1090 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1091 \uc0\u1088 \uc0\u1091  \uc0\u1088 \uc0\u1077 \uc0\u1096 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1081  \uc0\u1076 \uc0\u1083 \uc0\u1103  \uc0\u1076 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1080 \uc0\u1078 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1084 \uc0\u1072 \uc0\u1082 \uc0\u1089 \uc0\u1080 \uc0\u1084 \uc0\u1072 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1086 \uc0\u1075 \uc0\u1086  \uc0\u1073 \uc0\u1080 \uc0\u1079 \uc0\u1085 \uc0\u1077 \uc0\u1089 -\uc0\u1088 \uc0\u1077 \uc0\u1079 \uc0\u1091 \uc0\u1083 \uc0\u1100 \uc0\u1090 \uc0\u1072 \uc0\u1090 \uc0\u1072 .{\line}{\line}\uc0\u1042  \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1077  \uc0\u1080  \uc0\u1083 \uc0\u1080 \uc0\u1095 \uc0\u1085 \uc0\u1086 \uc0\u1081  \uc0\u1078 \uc0\u1080 \uc0\u1079 \uc0\u1085 \uc0\u1080  \uc0\u1080 \uc0\u1089 \uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1100 \uc0\u1079 \uc0\u1091 \uc0\u1102  \uc0\u1048 \uc0\u1048  \uc0\u1080 \uc0\u1085 \uc0\u1089 \uc0\u1090 \uc0\u1088 \uc0\u1091 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1099 . \uc0\u1055 \uc0\u1086 \uc0\u1089 \uc0\u1083 \uc0\u1077 \uc0\u1076 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1099 : \uc0\u1086 \uc0\u1085 \uc0\u1083 \uc0\u1072 \uc0\u1081 \uc0\u1085 \uc0\u1087 \uc0\u1088 \uc0\u1086 .\uc0\u1088 \uc0\u1092 {\line}{\line}\uc0\u1045 \uc0\u1089 \uc0\u1090 \uc0\u1100  \uc0\u1080 \uc0\u1076 \uc0\u1077 \uc0\u1103  \uc0\u1080 \uc0\u1083 \uc0\u1080  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1073 \uc0\u1083 \uc0\u1077 \uc0\u1084 \uc0\u1072  \uc0\u1080  \uc0\u1085 \uc0\u1077  \uc0\u1079 \uc0\u1085 \uc0\u1072 \uc0\u1077 \uc0\u1090 \uc0\u1077 , \uc0\u1095 \uc0\u1090 \uc0\u1086  \uc0\u1076 \uc0\u1077 \uc0\u1083 \uc0\u1072 \uc0\u1090 \uc0\u1100  \uc0\u1076 \uc0\u1072 \uc0\u1083 \uc0\u1100 \uc0\u1096 \uc0\u1077 ? \uc0\u1071  \uc0\u1042 \uc0\u1072 \uc0\u1084  \uc0\u1087 \uc0\u1086 \uc0\u1084 \uc0\u1086 \uc0\u1075 \uc0\u1091 ; \uc0\u1088 \uc0\u1072 \uc0\u1079 \uc0\u1073 \uc0\u1077 \uc0\u1088 \uc0\u1091  \uc0\u1080 \uc0\u1076 \uc0\u1077 \uc0\u1102  \uc0\u1085 \uc0\u1072  \uc0\u1092 \uc0\u1080 \uc0\u1095 \uc0\u1080 , \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1077 \uc0\u1088 \uc0\u1102  \uc0\u1075 \uc0\u1080 \uc0\u1087 \uc0\u1086 \uc0\u1090 \uc0\u1077 \uc0\u1079 \uc0\u1099 , \uc0\u1089 \uc0\u1092 \uc0\u1086 \uc0\u1088 \uc0\u1084 \uc0\u1080 \uc0\u1088 \uc0\u1091 \uc0\u1102  \uc0\u1073 \uc0\u1101 \uc0\u1082 \uc0\u1083 \uc0\u1086 \uc0\u1075 , \uc0\u1087 \uc0\u1086 \uc0\u1076 \uc0\u1073 \uc0\u1077 \uc0\u1088 \uc0\u1091  \uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1072 \uc0\u1085 \uc0\u1076 \uc0\u1091  \uc0\u1080  \uc0\u1079 \uc0\u1072 \uc0\u1087 \uc0\u1091 \uc0\u1097 \uc0\u1091  \uc0\u1080 \uc0\u1076 \uc0\u1077 \uc0\u1102  \uc0\u1074  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1076 .}\cell\row



