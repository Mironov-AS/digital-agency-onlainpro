<?xml version="1.0" encoding="utf-8"?>
<!--
  Android Auto App Descriptor для OSM Navigator

  Этот файл объявляет приложение как навигационное приложение
  для Android Auto / Android Automotive OS.

  После генерации Android-проекта (npx expo prebuild) этот файл
  должен быть скопирован в:
  android/app/src/main/res/xml/automotive_app_desc.xml

  Также необходимо:
  1. Добавить android:autoVerify="true" в intent-filter
  2. Добавить CarAppLibrary dependency в build.gradle
  3. Зарегистрировать OSMNavCarAppService в AndroidManifest.xml
  4. Добавить CarProjectionPackage в MainApplication
-->
<automotiveApp>
    <usesName name="automotive.navigation"/>
    <usesName name="automotive.instrument.cluster.indicator"/>
</automotiveApp>
