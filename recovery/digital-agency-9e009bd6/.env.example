# =============================================================================
# Production Environment Configuration Template
# Цифровое агентство ОнлайнПро.РФ
# =============================================================================
# Скопируйте этот файл в .env и заполните реальными значениями:
# cp .env.example .env

# =============================================================================
# SECTION 1: Security (REQUIRED - change these in production!)
# =============================================================================

# JWT Secrets (минимум 32 символа)
# Генерируйте новые с помощью: openssl rand -base64 32
JWT_ACCESS_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_32
JWT_REFRESH_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_32
JWT_ACCESS_EXPIRES=15m

# =============================================================================
# SECTION 2: Domain & CORS
# =============================================================================

# Your production domain (without trailing slash)
CORS_ORIGIN=https://your-domain.com

# =============================================================================
# SECTION 3: Admin Account
# =============================================================================

# Admin email and password for initial setup
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=CHANGE_ME_strong_password

# =============================================================================
# SECTION 4: Database (REQUIRED)
# =============================================================================

# PostgreSQL connection string.
# search_path определяет схемы сервисов. Для label-merger-service
# обязательно указывать 'label_merger,shelf', чтобы были доступны
# таблицы jobs (label_merger) и product_subscriptions/products (shelf).
DATABASE_URL=postgresql://user:password@localhost:5432/db_name?options=-c search_path=label_merger,shelf

# =============================================================================
# SECTION 5: Service URLs (for internal docker network)
# =============================================================================

AUTH_SERVICE_URL=http://auth-service:4001
CATALOG_SERVICE_URL=http://catalog-service:4002
CLIENTS_SERVICE_URL=http://clients-service:4003
PROJECTS_SERVICE_URL=http://projects-service:4004
ADMIN_SERVICE_URL=http://admin-service:4005
PRODUCT_SHELF_URL=http://product-shelf-service:4006
QUEUE_SERVICE_URL=http://queue-service:3001
QUEUE_DASHBOARD_URL=http://queue-service:3002
BOOKING_SERVICE_URL=http://booking-service:4008

# =============================================================================
# SECTION 6: Backup Settings
# =============================================================================

BACKUP_ENABLED=true
BACKUP_DIR=/backups
BACKUP_KEEP_DAYS=30
BACKUP_SCHEDULE="0 3 * * *"

# =============================================================================
# SECTION 7: Server Settings
# =============================================================================

NODE_ENV=production